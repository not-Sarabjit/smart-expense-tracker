# This file documents every environment variable the project uses.

# --- app ---
APP_ENVIRONMENT=dev          # dev | test | prod
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true         # false = coloured console output for local dev (logs/app.log stays JSON)


# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=50
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ─── Auth / JWT ─────────────────────────────────────────────────────
SECRET_KEY=a-random-string
TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Redis ──────────────────────────────────────────────────────────
# Used for rate limiting, caching, Celery broker (Phase 6+)
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant (vector DB) ────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=expense_docs

# ─── AI / LLM (Phase 1+) ───────────────────────────────────────────
# AI_ENABLED=true
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=

# ─── Observability (Phase 2+) ──────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3100

# ─── Object Storage (Phase 6+) ─────────────────────────────────────
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=expense-tracker